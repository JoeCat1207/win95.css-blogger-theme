          <span>Add Profile, Labels, Archive, or HTML gadgets here from Layout.</span>
        </div>
        <b:section class='sidebar' id='sidebar' maxwidgets='8' name='Sidebar' showaddelement='yes'>
        </b:section>
      </div>
    </div>

    <div id='layout-footer'>
      <b:section class='footer' id='footer' maxwidgets='3' name='Footer' showaddelement='yes'>
      </b:section>
    </div>
  </div>

  <div id='taskbar'>
    <a class='start-button' expr:href='data:blog.homepageUrl'>
      <img alt='' src='https://cdn.jsdelivr.net/gh/JoeCat1207/win95.css-blogger-theme@master/assets/icons/windows-0.png'/>
      <span>Start</span>
    </a>
    <div class='clock'>Online</div>
    <div class='task-button'>
      <img alt='' src='https://cdn.jsdelivr.net/gh/JoeCat1207/win95.css-blogger-theme@master/assets/icons/html-0.png'/>
      <span><data:blog.pageTitle/></span>
    </div>
  </div>
</body>
</html>
